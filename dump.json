tromotors.com\\\",\\n        \\\"If you are submitting via email, mention:**Test Drive at Doorstep Request** in the subject line.\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"If you haven't received a confirmation email after submitting your test drive request, please contact us directly via phone at +91 124 1234567 or email at info@aventromotors.com, ensuring you mention 'Test Drive at Doorstep Request' in the subject line.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Edge-Case & Error Handling Query\\\",\\n      \\\"query_text\\\": \\\"Umm, how do I bk a tdrve, pls?\\\",\\n      \\\"facts\\\": [\\n        \\\"Fill in the form below or contact us directly: - Phone: +91 124 1234567 - Email: info@aventromotors.com\\\",\\n        \\\"**Required Details:** - Full Name - Mobile Number - Email Address - Preferred Model & Variant (e.g., Aventro Zoom Petrol ZX) - Preferred Date & Time - Complete Address for Test Drive - Any Special Requests\\/Comments\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"To book a test drive, please fill in the form with all the required details or contact us directly via phone at +91 124 1234567 or email at info@aventromotors.com.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Competitor Related Query\\\",\\n      \\\"query_text\\\": \\\"How does Aventro Motors' doorstep test drive service compare with other companies?\\\",\\n      \\\"facts\\\": [\\n        \\\"Welcome to Aventro Motors Pvt. Ltd.!  Experience the future of mobility from the comfort of your home. Book a test drive for any Aventro car, and we\\u2019ll bring your chosen model to your doorstep, anywhere in India.\\\",\\n        \\\"Choose Your Car  Select from 20 models across Hatchback, Sedan, and SUV categories, with Petrol, Diesel, Electric, and Hybrid variants.\\\",\\n        \\\"Pick a Convenient Time  Let us know your preferred date and time for the test drive.\\\",\\n        \\\"We Bring the Car to You  Our representative will arrive at your location for the test drive at the scheduled time.\\\",\\n        \\\"Explore & Experience  Take your time to explore features, ask questions, and experience the drive.\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"Aventro Motors offers a unique service by bringing the test drive directly to your doorstep anywhere in India. With a selection of 20 models across various categories and fuel options, a convenient scheduling process, and a direct home visit by our representative, our service stands out through its comprehensive and customer-friendly approach.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Feedback Related Query\\\",\\n      \\\"query_text\\\": \\\"I'm disappointed that your booking form feels overly long and confusing.\\\",\\n      \\\"facts\\\": [],\\n      \\\"expected_answer\\\": \\\"Thank you for your feedback. We appreciate your input and will work to improve your experience.\\\"\\n    }\\n  ]\\n}\",\"4\":\"{\\n  \\\"items\\\": [\\n    {\\n      \\\"category\\\": \\\"Specific Query\\\",\\n      \\\"query_text\\\": \\\"What are the available petrol variants for the Aventro Storm SUV and what are their key features and prices?\\\",\\n      \\\"facts\\\": [\\n        \\\"Base (Petrol): 7-inch Infotainment, Standard Safety, Fabric Seats, Ex-Showroom Price (\\u20b9 Lakh): 14.8\\\",\\n        \\\"X (Petrol): 11-inch Infotainment, Panoramic Sunroof, ADAS Level 1, Ex-Showroom Price (\\u20b9 Lakh): 15.3\\\",\\n        \\\"ZX (Petrol): 360\\u00ba Camera, 11-inch Harman Infotainment, ADAS Level 2, Leather Seats, Ex-Showroom Price (\\u20b9 Lakh): 15.8\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"The Aventro Storm SUV offers three petrol variants: Base with 7-inch Infotainment, Standard Safety, Fabric Seats at 14.8 \\u20b9 Lakh; X with 11-inch Infotainment, Panoramic Sunroof, ADAS Level 1 at 15.3 \\u20b9 Lakh; and ZX with 360\\u00ba Camera, 11-inch Harman Infotainment, ADAS Level 2, Leather Seats at 15.8 \\u20b9 Lakh.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Compound Query\\\",\\n      \\\"query_text\\\": \\\"Can you tell me the available color options for the Aventro Storm SUV and also explain what safety features are included across all variants?\\\",\\n      \\\"facts\\\": [\\n        \\\"Colors Available: Arctic White, Midnight Black, Lava Red, Forest Green, Royal Blue\\\",\\n        \\\"Safety & Tech Packages: 6 Airbags Standard, ABS, Electronic Stability Program (ESP), Rear Parking Sensors & Camera (All Variants), ISOFIX Child Seat Mounts, Tyre Pressure Monitoring System (X & ZX)\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"The Aventro Storm SUV is available in Arctic White, Midnight Black, Lava Red, Forest Green, and Royal Blue. Across all variants, it includes safety features such as 6 Airbags Standard, ABS, Electronic Stability Program (ESP), Rear Parking Sensors & Camera, ISOFIX Child Seat Mounts, and the Tyre Pressure Monitoring System on X and ZX variants.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Instructional Query\\\",\\n      \\\"query_text\\\": \\\"Could you provide step-by-step guidance on how to book a test drive for the Aventro Storm SUV using the provided contact details?\\\",\\n      \\\"facts\\\": [\\n        \\\"Book a test drive today at your nearest Aventro dealership or service center!\\\",\\n        \\\"For bookings and more information:  \\ud83d\\udcde +91 124 1234567  \\u2709\\ufe0f info@aventromotors.com\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"To book a test drive, visit your nearest Aventro dealership or service center and use the provided contact details: call +91 124 1234567 or email info@aventromotors.com for more information.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Opinion-Based Query\\\",\\n      \\\"query_text\\\": \\\"Which variant of the Aventro Storm SUV would you recommend for someone who values high-end safety and tech features?\\\",\\n      \\\"facts\\\": [\\n        \\\"ZX Variant Exclusive: 11-inch Touchscreen Infotainment System (Harman Audio), 360\\u00ba Surround View Camera, ADAS Level 2: Adaptive Cruise, Lane Centering, Traffic Sign Recognition, Leather Seats & Premium Interior, Powered Driver Seat\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"For someone valuing high-end safety and technology, the ZX variant is highly recommended as it features a 11-inch Touchscreen Infotainment System (Harman Audio), a 360\\u00ba Surround View Camera, ADAS Level 2 with Adaptive Cruise, Lane Centering, Traffic Sign Recognition, and premium elements like Leather Seats and Powered Driver Seat.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Error\\/Issue Query\\\",\\n      \\\"query_text\\\": \\\"I tried to schedule a test drive online but kept facing issues with the booking page, and it didn't show all available variants. Can you please help me resolve this problem?\\\",\\n      \\\"facts\\\": [\\n        \\\"Book a test drive today at your nearest Aventro dealership or service center!\\\",\\n        \\\"For bookings and more information:  \\ud83d\\udcde +91 124 1234567  \\u2709\\ufe0f info@aventromotors.com\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"We apologize for the inconvenience. Please book a test drive by visiting your nearest Aventro dealership or service center and contact us at +91 124 1234567 or info@aventromotors.com for further assistance.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Edge-Case & Error Handling Query\\\",\\n      \\\"query_text\\\": \\\"Aventro Storm suv help me bk test drv\\\",\\n      \\\"facts\\\": [\\n        \\\"Book a test drive today at your nearest Aventro dealership or service center!\\\",\\n        \\\"For bookings and more information:  \\ud83d\\udcde +91 124 1234567  \\u2709\\ufe0f info@aventromotors.com\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"To book a test drive for the Aventro Storm SUV, please visit your nearest Aventro dealership or service center and contact us at +91 124 1234567 or email info@aventromotors.com.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Competitor Related Query\\\",\\n      \\\"query_text\\\": \\\"I noticed that a competitor's SUV offers similar safety features. Can you explain what sets the Aventro Storm SUV apart in terms of technology and safety packages?\\\",\\n      \\\"facts\\\": [\\n        \\\"The Aventro Storm is a premium SUV designed for modern adventurers and families, blending robust performance, advanced safety, elegant design, and cutting-edge technology. Whether city driving or off-the-grid journeys, the Storm SUV ensures comfort, safety, and excitement.\\\",\\n        \\\"Safety & Tech Packages: 6 Airbags Standard, ABS, Electronic Stability Program (ESP), Rear Parking Sensors & Camera (All Variants), ISOFIX Child Seat Mounts, Tyre Pressure Monitoring System (X & ZX)\\\",\\n        \\\"ZX Variant Exclusive: 11-inch Touchscreen Infotainment System (Harman Audio), 360\\u00ba Surround View Camera, ADAS Level 2: Adaptive Cruise, Lane Centering, Traffic Sign Recognition, Leather Seats & Premium Interior, Powered Driver Seat\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"The Aventro Storm SUV stands out with its blend of robust performance, advanced safety, elegant design, and cutting-edge technology, including comprehensive safety packages\\u20146 Airbags Standard, ABS, ESP, and more\\u2014as well as exclusive high-tech features like the 360\\u00ba Surround View Camera and ADAS Level 2 available in the ZX variant.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Feedback Related Query\\\",\\n      \\\"query_text\\\": \\\"I recently visited your dealership, and the test drive process was really slow with a long waiting time.\\\",\\n      \\\"facts\\\": [],\\n      \\\"expected_answer\\\": \\\"Thank you for your feedback. We will investigate and work to improve our service.\\\"\\n    }\\n  ]\\n}\",\"5\":\"{\\n  \\\"items\\\": [\\n    {\\n      \\\"category\\\": \\\"Specific Query\\\",\\n      \\\"query_text\\\": \\\"Can you provide detailed instructions on how to open the fuel knob in my Aventro car?\\\",\\n      \\\"facts\\\": [\\n        \\\"Ensure your car is completely stopped and the engine is turned off.\\\",\\n        \\\"Engage the parking brake for safety.\\\",\\n        \\\"The fuel knob release lever is typically found: On the driver\\u2019s side floor, near the seat or door. In some models, it may be on the dashboard or central console.\\\",\\n        \\\"Pull up or push the lever labelled with a fuel pump icon. You may hear a click indicating the fuel lid has been released.\\\",\\n        \\\"Step out of the vehicle and go to the side where the fuel lid (fuel door) is located.\\\",\\n        \\\"Gently open the fuel lid. You\\u2019ll now see the fuel knob (fuel cap).\\\",\\n        \\\"Twist the fuel knob (cap) anti-clockwise to unscrew it. Remove the cap and place it in a secure slot (usually on the lid itself or hold it carefully).\\\",\\n        \\\"Screw the fuel knob (cap) back on clockwise until you hear a click (to ensure it\\u2019s sealed).\\\",\\n        \\\"Close the fuel lid securely.\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"To open the fuel knob in your Aventro car, first ensure your car is completely stopped, the engine is off, and the parking brake is engaged. Next, locate the fuel knob release lever on the driver\\u2019s side floor (or on the dashboard\\/central console in some models) and pull the lever labelled with a fuel pump icon until you hear a click. Then, exit the vehicle, gently open the fuel lid to reveal the fuel cap, and twist the cap anti-clockwise to remove it. After refueling, screw the cap back on clockwise until you hear a click and close the fuel lid securely.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Compound Query\\\",\\n      \\\"query_text\\\": \\\"What steps do I need to follow to open the fuel knob on my Aventro car, and what should I do if the fuel lid doesn\\u2019t open as expected?\\\",\\n      \\\"facts\\\": [\\n        \\\"Ensure your car is completely stopped and the engine is turned off.\\\",\\n        \\\"Engage the parking brake for safety.\\\",\\n        \\\"The fuel knob release lever is typically found: On the driver\\u2019s side floor, near the seat or door. In some models, it may be on the dashboard or central console.\\\",\\n        \\\"Pull up or push the lever labelled with a fuel pump icon. You may hear a click indicating the fuel lid has been released.\\\",\\n        \\\"Step out of the vehicle and go to the side where the fuel lid (fuel door) is located.\\\",\\n        \\\"Gently open the fuel lid. You\\u2019ll now see the fuel knob (fuel cap).\\\",\\n        \\\"Twist the fuel knob (cap) anti-clockwise to unscrew it. Remove the cap and place it in a secure slot (usually on the lid itself or hold it carefully).\\\",\\n        \\\"If the Fuel Lid Doesn\\u2019t Open: Ensure the car is unlocked; some models require all doors to be unlocked before the lever works.\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"To open the fuel knob, you should ensure your car is stopped with the engine off and the parking brake engaged, then locate and pull the fuel knob release lever (found on the driver\\u2019s side floor or on the dashboard\\/central console) until you hear a click. Next, exit the vehicle, open the fuel lid, and twist the fuel knob anti-clockwise to remove it. If the fuel lid doesn\\u2019t open, make sure the car is unlocked, as some models require all doors to be unlocked before the lever works.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Instructional Query\\\",\\n      \\\"query_text\\\": \\\"Could you guide me step-by-step on how to open the fuel knob of my Aventro car?\\\",\\n      \\\"facts\\\": [\\n        \\\"Ensure your car is completely stopped and the engine is turned off.\\\",\\n        \\\"Engage the parking brake for safety.\\\",\\n        \\\"The fuel knob release lever is typically found: On the driver\\u2019s side floor, near the seat or door. In some models, it may be on the dashboard or central console.\\\",\\n        \\\"Pull up or push the lever labelled with a fuel pump icon. You may hear a click indicating the fuel lid has been released.\\\",\\n        \\\"Step out of the vehicle and go to the side where the fuel lid (fuel door) is located.\\\",\\n        \\\"Gently open the fuel lid. You\\u2019ll now see the fuel knob (fuel cap).\\\",\\n        \\\"Twist the fuel knob (cap) anti-clockwise to unscrew it. Remove the cap and place it in a secure slot (usually on the lid itself or hold it carefully).\\\",\\n        \\\"Screw the fuel knob (cap) back on clockwise until you hear a click (to ensure it\\u2019s sealed).\\\",\\n        \\\"Close the fuel lid securely.\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"First, ensure your car is completely stopped, the engine is off, and the parking brake is engaged. Then, locate the fuel knob release lever on the driver\\u2019s side floor (or dashboard\\/central console in some models) and pull the lever labelled with a fuel pump icon until you hear a click. Next, exit the vehicle, open the fuel lid to expose the fuel cap, twist the fuel cap anti-clockwise to remove it, and after refueling, screw the cap back on clockwise until you hear a click, then close the fuel lid securely.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Opinion-Based Query\\\",\\n      \\\"query_text\\\": \\\"What do you think about the ease of opening the fuel knob in Aventro cars?\\\",\\n      \\\"facts\\\": [\\n        \\\"Opening the fuel knob (fuel cap) on your Aventro vehicle is a simple process.\\\",\\n        \\\"The fuel knob release lever is typically found: On the driver\\u2019s side floor, near the seat or door. In some models, it may be on the dashboard or central console.\\\",\\n        \\\"Pull up or push the lever labelled with a fuel pump icon. You may hear a click indicating the fuel lid has been released.\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"The document describes opening the fuel knob as a simple process, with a conveniently located release lever on the driver\\u2019s side floor or dashboard\\/central console and a clear action of pulling a lever marked with a fuel pump icon.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Error\\/Issue Query\\\",\\n      \\\"query_text\\\": \\\"I tried to open the fuel knob on my Aventro car but nothing happened when I pulled the lever. What could be the issue?\\\",\\n      \\\"facts\\\": [\\n        \\\"If the Fuel Lid Doesn\\u2019t Open: Ensure the car is unlocked; some models require all doors to be unlocked before the lever works.\\\",\\n        \\\"Never Force the Cap: If the knob is stuck, double-check that the release mechanism is fully engaged.\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"If your Aventro's fuel knob isn\\u2019t opening, make sure that your car is unlocked, as some models require all doors to be unlocked, and double-check that the release mechanism is fully engaged without forcing the cap.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Edge-Case & Error Handling Query\\\",\\n      \\\"query_text\\\": \\\"Hw d i open fuel cap?\\\",\\n      \\\"facts\\\": [\\n        \\\"Ensure your car is completely stopped and the engine is turned off.\\\",\\n        \\\"Pull up or push the lever labelled with a fuel pump icon. You may hear a click indicating the fuel lid has been released.\\\",\\n        \\\"Gently open the fuel lid. You\\u2019ll now see the fuel knob (fuel cap).\\\",\\n        \\\"Twist the fuel knob (cap) anti-clockwise to unscrew it.\\\"\\n      ],\\n      \\\"expected_answer\\\": \\\"First, ensure your car is off. Then, pull up or push the lever labelled with a fuel pump icon until you hear a click. Next, open the fuel lid and twist the fuel knob anti-clockwise to remove it.\\\"\\n    },\\n    {\\n      \\\"category\\\": \\\"Competitor Related Query\\\",\\n      \\\"query_text\\\": \\\"How does opening the fuel knob in Aventr